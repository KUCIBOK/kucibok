# ============================================================
# KUCIBOK — Variables d'environnement Vercel (serveur + client)
# ============================================================
#
# Ce fichier documente TOUTES les variables à configurer dans :
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# Il est en 2 sections :
#   A) Variables SERVEUR  — utilisées par les Vercel Functions (api/)
#      Préfixe : aucun (ex: SUPABASE_URL)
#      Accès   : process.env.VAR dans api/_lib/*.js et api/[...path].js
#      JAMAIS exposées côté client.
#
#   B) Variables CLIENT   — injectées dans le bundle React par Vite
#      Préfixe : VITE_ obligatoire (ex: VITE_SUPABASE_URL)
#      Accès   : import.meta.env.VITE_VAR dans src/
#      VISIBLES dans le JavaScript public — ne jamais y mettre de secrets.
#
# Environnements Vercel à configurer :
#   - Production  (branche main)
#   - Preview     (branches feat/fix — optionnel)
#   - Development (vercel dev — optionnel)
# ============================================================


# ============================================================
# A) VARIABLES SERVEUR — Vercel Functions
#    (process.env.VAR dans api/)
# ============================================================

# ------------------------------------------------------------
# SUPABASE — côté serveur
# Dashboard : https://supabase.com/dashboard → Settings → API
#
# SUPABASE_URL             : Project URL (même que VITE_SUPABASE_URL)
# SUPABASE_SERVICE_ROLE_KEY: service_role key — JAMAIS côté client
#                            Bypass total des RLS — admin uniquement.
# SUPABASE_ANON_KEY        : anon/public key (même que VITE_SUPABASE_ANON_KEY)
#                            Utilisée dans supabaseForUser() pour les requêtes scoped.
# ------------------------------------------------------------
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE_KEY_ICI...
SUPABASE_ANON_KEY=eyJ...ANON_KEY_ICI...

# ------------------------------------------------------------
# API KEY INTERNE — clé partagée entre frontend et Vercel Functions
# Envoyée dans le header HTTP : kcb-api-key: <valeur>
# Doit correspondre EXACTEMENT à VITE_API_KEY côté client.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
API_KEY=GENERER_UNE_CLE_ALEATOIRE_64_CHARS_HEX

# ------------------------------------------------------------
# RATE LIMITING — recommandé en production
# Sans ces variables, le fallback mémoire n'est pas distribué entre les
# instances Vercel et ne constitue pas une protection globale.
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://VOTRE_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=VOTRE_TOKEN_UPSTASH

# ------------------------------------------------------------
# CORS — Origine autorisée pour les fonctions serveur
# Production : https://kucibok.com
# Preview    : https://kucibok-BRANCH.vercel.app (optionnel)
# Dev local  : http://localhost:3000 (si vercel dev + yarn dev sur ports différents)
# ------------------------------------------------------------
CORS_ORIGIN=https://kucibok.com

# ------------------------------------------------------------
# RESEND — Emails transactionnels (confirmation, reset pwd, etc.)
# Dashboard : https://resend.com/api-keys
# ------------------------------------------------------------
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# EMAILS — Adresses système
# ------------------------------------------------------------
ADMIN_EMAIL=admin@kucibok.com
ALERT_RECEIVER=alerts@kucibok.com

# ------------------------------------------------------------
# PAYDUNYA — Paiement Mobile Money (West Africa)
# Dashboard : https://app.paydunya.com
# PAYDUNYA_MODE : "test" (sandbox) ou "live" (production réelle)
# Utiliser "test" jusqu'à la validation complète en prod.
# ------------------------------------------------------------
PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=PAYDUNYA_MASTER_KEY_ICI
PAYDUNYA_PRIVATE_KEY=PAYDUNYA_PRIVATE_KEY_ICI
PAYDUNYA_TOKEN=PAYDUNYA_TOKEN_ICI

# ------------------------------------------------------------
# URL DE BASE — utilisée pour construire les liens dans les emails
# (ex: lien de reset password, lien de confirmation)
# En production : https://kucibok.com
# ------------------------------------------------------------
BASE_URL=https://kucibok.com


# ============================================================
# B) VARIABLES CLIENT — Bundle React (Vite)
#    (import.meta.env.VITE_VAR dans src/)
# Ces variables sont aussi à mettre dans Vercel Dashboard
# car Vercel injecte les VITE_* au build time.
# ============================================================

# ------------------------------------------------------------
# SUPABASE — côté client (anon key uniquement — SAFE)
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...ANON_KEY_ICI...

# ------------------------------------------------------------
# API — URL de base et clé partagée
# En production sur Vercel : VITE_API_URL=/api (relatif — ne pas changer)
# VITE_API_KEY doit correspondre EXACTEMENT à API_KEY ci-dessus.
# ------------------------------------------------------------
VITE_API_URL=/api
VITE_API_KEY=GENERER_UNE_CLE_ALEATOIRE_64_CHARS_HEX

# ------------------------------------------------------------
# GOOGLE OAUTH
# Dashboard : https://console.cloud.google.com
# → APIs & Services → Identifiants → ID client OAuth 2.0
# Origines autorisées : https://kucibok.com
# URI de redirection : https://VOTRE_PROJECT_ID.supabase.co/auth/v1/callback
#                     (Supabase gère le callback OAuth, pas le front)
# ------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=XXXXXXXXXXXXX.apps.googleusercontent.com

# ------------------------------------------------------------
# Maintenance — mettre à true pendant la bascule production (RUNBOOK Etape 1)
# Remettre à false après validation. Ne pas oublier de redéployer.
# ------------------------------------------------------------
VITE_MAINTENANCE_MODE=false

# ------------------------------------------------------------
# NON UTILISÉS EN PRODUCTION — à omettre ou laisser vide
# ------------------------------------------------------------
# VITE_DEV_BACKEND_URL=  (uniquement pour yarn dev en local — pas besoin sur Vercel)
# VITE_SOCKET_URL=       (enchères WebSocket — non actif)
