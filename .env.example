# kucibok — Environment contract
# Copy to .env (or .env.local) and fill in real values. NEVER commit .env.

# --- API server (backend) ---
API_KEY=
CORS_ORIGIN=

# --- Supabase (server) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
ADMIN_EMAIL=
ALERT_RECEIVER=

# --- Payments (Paydunya) ---
PAYDUNYA_MODE=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# --- Logistics (Logidoo) ---
LOGIDOO_API_KEY=
LOGIDOO_ENV=
# Secret de l'URL du webhook Logidoo (…/api/logistics/logidoo/webhook?secret=…)
LOGIDOO_WEBHOOK_SECRET=

# --- Frontend (Vite — must use VITE_ prefix to be exposed) ---
VITE_API_URL=
VITE_API_KEY=
VITE_DEV_BACKEND_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=
VITE_MAINTENANCE_MODE=
