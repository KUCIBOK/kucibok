{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sentry:upload-sourcemaps": "sentry-cli releases -o $SENTRY_ORG -p $SENTRY_PROJECT new $SENTRY_RELEASE || true && sentry-cli releases -o $SENTRY_ORG -p $SENTRY_PROJECT files $SENTRY_RELEASE upload-sourcemaps ./dist --rewrite && sentry-cli releases -o $SENTRY_ORG -p $SENTRY_PROJECT finalize $SENTRY_RELEASE",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "newman run postman/kucibok.postman_collection.json -e postman/kucibok.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/api-test-report.html",
    "test:api:ci": "newman run postman/kucibok.postman_collection.json -e postman/kucibok.postman_environment.json --reporters cli",
    "prepare": "node -e \"if(process.env.CI){process.exit(0)}\" || husky"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.0.17",
    "@tanstack/react-query": "5",
    "@upstash/redis": "^1.38.2",
    "axios": "^1.20.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.4.9",
    "cloudinary": "^2.11.0",
    "dompurify": "^3.3.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.484.0",
    "mongoose": "^9.9.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-helmet": "^6.1.0",
    "react-multi-carousel": "^2.8.6",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.4.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@sentry/cli": "^2.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.4.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.8.1",
    "vite": "^6.3.2",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
